<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <BannedSymbolsFile>$(MSBuildThisFileDirectory)..\BannedSymbols.Tests.txt</BannedSymbolsFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Logic\Golden\*.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Logic\Map\Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Models\Translations\*.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Models\Ruleset\Unique\Golden\*.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unciv.Core\Unciv.Core.csproj" />
    <ProjectReference Include="..\Unciv.Harness\Unciv.Harness.csproj" />
  </ItemGroup>

</Project>