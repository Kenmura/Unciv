<Project>

  <!-- Shared build policy for every C# project. Rationale and ticket: migration/backlog/T013.md. -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Default analysis set plus the curated rules in .editorconfig. latest-recommended was tried and rejected: its
         design rules (CA1051, CA1708, CA1711, CA1715, CA2201...) fight Kotlin-faithful ports. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Required by Roslyn for IDE0005 (unused usings) to run during build; XML docs themselves are not required. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- JUSTIFY: T013 CS1591 only fires because GenerateDocumentationFile is on; we do not require XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <!-- Kotlin Int arithmetic wraps on overflow; keep C# unchecked explicitly so it can never drift. -->
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <!-- Culture-independent behaviour for string/number handling, belt and braces over the banned APIs. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BannedSymbolsFile>$(MSBuildThisFileDirectory)BannedSymbols.txt</BannedSymbolsFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(BannedSymbolsFile)" Link="BannedSymbols.txt" />
  </ItemGroup>

</Project>
