<Project Sdk="Microsoft.NET.Sdk">

  <!-- C007: engine-independent half of the client asset system (key resolution, fallback chains, procedural generation maths).
       Plain net10.0 with no Godot reference so the Standard checks build and test it; Unciv.Godot turns its output into engine objects. -->
  <PropertyGroup>
    <TargetFramework>$(UncivTfm)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unciv.Core\Unciv.Core.csproj" />
  </ItemGroup>

</Project>
