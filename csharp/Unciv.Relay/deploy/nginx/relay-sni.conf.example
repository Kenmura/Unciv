# nginx stream configuration for Unciv.Relay, variant 2: share port 443 with your website by SNI (design/RELAY.md section 8, SETUP.md).
# Use it only when players sit behind networks that block other ports AND you already run a website on 443. Otherwise prefer relay.conf.example.
# relay.example.org is a PLACEHOLDER: replace it with your own relay name.
#
# Here the RELAY keeps its own certificate (TLS passthrough): nginx only looks at the server name in the ClientHello and forwards the still-encrypted bytes.
# Relay in Docker, TLS mode B: UNCIV_RELAY_CERT=/certs/fullchain.pem, UNCIV_RELAY_KEY=/certs/privkey.pem, UNCIV_RELAY_TLS= (empty),
#   UNCIV_RELAY_PROXY_PROTOCOL=true, UNCIV_RELAY_TRUSTED_PROXY as in .env.example, RELAY_TUNNEL_PUBLISH=127.0.0.1:47833 (the port used below).
# Needs nginx built with --with-stream_ssl_preread_module. Your website's own server must move OFF 443 (here: 8443, edit its `listen` lines, and keep
# `listen 8443 ssl;` plus `set_real_ip_from`/`proxy_protocol` only if you need the visitor address, see the note at proxy_protocol below).
# Install like relay.conf.example (do NOT include both files: each defines its own stream { } block and they would both want to own a port).

stream {
    map $ssl_preread_server_name $unciv_backend {
        relay.example.org  127.0.0.1:47833;   # the relay
        default            127.0.0.1:8443;    # everything else: your existing web server, moved to 8443
    }

    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass $unciv_backend;
        # The relay needs the PROXY header for the real client address. Your web server then must accept it too: in its server block use
        # `listen 8443 ssl proxy_protocol;`. If it cannot, give the relay its own port instead (relay.conf.example, the recommendation).
        proxy_protocol on;
        proxy_timeout 1h;
    }
}
