# nginx stream configuration for Unciv.Relay, variant 1 (recommended): nginx owns the public port AND the certificate (design/RELAY.md section 8, SETUP.md).
# relay.example.org is a PLACEHOLDER: replace it with your own relay name (4 places below). Nothing here is a default of the software.
#
# The relay runs in Docker in TLS mode A (UNCIV_RELAY_TLS=none, UNCIV_RELAY_PROXY_PROTOCOL=true) and publishes its plain tunnel on 127.0.0.1:47832
# (RELAY_TUNNEL_PUBLISH in .env, the default). Without Docker: `Unciv.Relay --tls none --proxy-protocol --public-name relay.example.org --tunnel-port 47832`.
#
# Install: copy this file to /etc/nginx/unciv-relay-stream.conf and add this line at the TOP LEVEL of /etc/nginx/nginx.conf (next to http { }, NOT inside it):
#   include /etc/nginx/unciv-relay-stream.conf;
# Needs nginx >= 1.21.4 (ssl_alpn) built with --with-stream and --with-stream_ssl_module (check: nginx -V 2>&1 | tr ' ' '\n' | grep stream).
# Test and apply:  sudo nginx -t && sudo systemctl reload nginx
# Related files: relay-sni.conf.example (share port 443 with a website), relay-http.conf.example (the optional read-only HTTP directory).

stream {
    limit_conn_zone $binary_remote_addr zone=relay_per_ip:10m;

    server {
        listen 47830 ssl;                 # the public tunnel port; players type relay.example.org:47830 (or use 443, see relay-sni.conf.example)
        listen [::]:47830 ssl;
        ssl_certificate     /etc/letsencrypt/live/relay.example.org/fullchain.pem;   # PLACEHOLDER name; certbot creates this directory
        ssl_certificate_key /etc/letsencrypt/live/relay.example.org/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_alpn unciv-relay/1;

        proxy_pass 127.0.0.1:47832;       # the relay's plain tunnel port on this host (the container's published port)
        proxy_protocol on;                # tells the relay the real client address for its limits and bans
        proxy_timeout 1h;                 # a game connection is long-lived; the relay itself closes idle splices after 120 s
        proxy_connect_timeout 5s;
        limit_conn relay_per_ip 40;       # same as the relay's per-network default
    }
}
