# Unciv.Relay settings for docker compose (T374). Copy this file to .env (cp .env.example .env), edit it, then `docker compose up -d --build`.
# .env is ignored by git: it never gets committed. relay.example.org is a PLACEHOLDER everywhere: replace it with your own DNS name.
# An empty value means "the relay's own default". Every UNCIV_RELAY_<NAME> variable is the relay option --<name> in upper case with _ for -
# (the relay also accepts them outside Docker). Precedence: command line over relay.json in the data volume over these variables.
# Not settable here: the container's fixed UNCIV_RELAY_DATA_DIR, _BIND, _HTTP_BIND, _TUNNEL_PORT and _HTTP_PORT (published below), and the
# test-only UNCIV_RELAY_SWEEP_INTERVAL_MILLIS / the config path UNCIV_RELAY_CONFIG (use relay.json in the data volume instead).

# --- Which host addresses publish the container's ports (docker compose, not relay options) ---
# Mode A (behind nginx on the same host): keep both on 127.0.0.1; nginx proxies to the tunnel port 47832 (the example config uses it).
# Modes B and C (the relay owns the public port): RELAY_TUNNEL_PUBLISH=0.0.0.0:47830 (or [::]:47830 too); leave the HTTP side on 127.0.0.1.
RELAY_TUNNEL_PUBLISH=127.0.0.1:47832
RELAY_HTTP_PUBLISH=127.0.0.1:47831
# Mode B only: the host directory holding fullchain.pem and privkey.pem, readable by uid 10001 (SETUP.md step on certificates).
RELAY_CERT_DIR=./certs


# --- TLS mode (choose exactly ONE of the three: A behind nginx, B certificate, C self-signed; see SETUP.md) ---
# A: 'none' = plain TCP behind nginx, which owns the certificate. Leave EMPTY for modes B and C.
UNCIV_RELAY_TLS=none
# B: path INSIDE the container of the certificate chain, e.g. /certs/fullchain.pem (RELAY_CERT_DIR is mounted at /certs).
UNCIV_RELAY_CERT=
# B: path inside the container of the private key, e.g. /certs/privkey.pem.
UNCIV_RELAY_KEY=
# C: true = generate a certificate in the data volume; players pin the fingerprint the relay prints. Needs PUBLIC_NAME.
UNCIV_RELAY_SELF_SIGNED=
# The name hosts sign: your DNS name (or an IP in mode C). Required for A and C; in B it defaults to the certificate's names. Comma-separated for several.
UNCIV_RELAY_PUBLIC_NAME=relay.example.org
# A: true = read the PROXY header nginx sends so limits and bans see the real client address. Empty/false for B and C.
UNCIV_RELAY_PROXY_PROTOCOL=true
# A: who may send that header = the container network nginx reaches the container from (comma-separated CIDRs). Docker's bridge is inside 172.16.0.0/12.
UNCIV_RELAY_TRUSTED_PROXY=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Listeners (inside the container the relay always listens on 47830 and 47831; the host side is RELAY_TUNNEL_PUBLISH / RELAY_HTTP_PUBLISH below) ---
# true = do not start the read-only HTTP side at all (no /healthz, no directory over HTTP; the container health check then only connects to the tunnel port).
UNCIV_RELAY_NO_HTTP=
# true = serve the HTTP side over HTTPS with the tunnel certificate (mode B or C only).
UNCIV_RELAY_HTTP_TLS=
# true = serve Prometheus text on GET /metrics (HTTP side).
UNCIV_RELAY_METRICS=

# --- Directory and information shown by GET /v1/info ---
# Who may list games in the public directory: open, allowlist (only keys in allow-keys.txt) or off.
UNCIV_RELAY_LISTING=open
# Display name of your relay (default 'Unciv relay').
UNCIV_RELAY_NAME=
# Abuse contact players can reach: put a real address here.
UNCIV_RELAY_CONTACT=abuse@relay.example.org
# Free text message shown by /v1/info.
UNCIV_RELAY_MOTD=

# --- Logs (one line per event on stdout: docker compose logs; and files in the data volume) ---
# debug, info (default), warn or error.
UNCIV_RELAY_LOG_LEVEL=
# Delete log files older than this many days (default 7).
UNCIV_RELAY_LOG_RETENTION_DAYS=
# true = write no log files, stdout only.
UNCIV_RELAY_NO_LOG_FILES=
# On stop, how many seconds running games get after the hosts were told to reconnect (default 10).
UNCIV_RELAY_DRAIN_SECONDS=

# --- Limits: the defaults are right for one small VM; the number in brackets is the default (an empty value keeps it) ---
# [200] rooms (hosted games) in total.
UNCIV_RELAY_MAX_ROOMS=
# [600] joined players in total.
UNCIV_RELAY_MAX_SPLICES=
# [4] host control connections per source network.
UNCIV_RELAY_MAX_CONTROL_PER_NETWORK=
# [2] rooms per source network (an IPv4 address or an IPv6 /64). Raise it if players behind one CGNAT address are refused.
UNCIV_RELAY_MAX_ROOMS_PER_NETWORK=
# [40] simultaneous connections per source network.
UNCIV_RELAY_MAX_CONNECTIONS_PER_NETWORK=
# [16] joiners in one room.
UNCIV_RELAY_MAX_JOINERS_PER_ROOM=
# [8] joins waiting for the host in one room.
UNCIV_RELAY_MAX_PENDING_PER_ROOM=
# [3] joiners per source network.
UNCIV_RELAY_MAX_JOINERS_PER_NETWORK=
# [30] handshakes per minute per source network.
UNCIV_RELAY_HANDSHAKES_PER_MINUTE=
# [10] joins per minute per source network.
UNCIV_RELAY_JOINS_PER_MINUTE=
# [10] unknown-room lookups per minute before a temporary ban.
UNCIV_RELAY_LOOKUP_FAILURES_PER_MINUTE=
# [10] length of that temporary ban in minutes.
UNCIV_RELAY_BAN_MINUTES=
# [6] directory listing changes per minute per host.
UNCIV_RELAY_LISTINGS_PER_MINUTE=
# [30] HTTP requests per minute per client.
UNCIV_RELAY_HTTP_REQUESTS_PER_MINUTE=
# [2097152] bytes per second sustained through one splice.
UNCIV_RELAY_SPLICE_RATE=
# [50331648] burst bytes of one splice (a 32 MiB save must pass).
UNCIV_RELAY_SPLICE_BURST=
# [21474836480] bytes per room per day (20 GiB).
UNCIV_RELAY_ROOM_BYTES_PER_DAY=
# [120] close a splice after this many silent seconds.
UNCIV_RELAY_IDLE_SECONDS=
# [90] close a host control connection after this many silent seconds.
UNCIV_RELAY_CONTROL_SILENCE_SECONDS=
# [30] drop a listing the host stopped refreshing.
UNCIV_RELAY_LISTING_STALE_MINUTES=
# [24] a room without its host is dropped after this many hours.
UNCIV_RELAY_ROOM_TTL_HOURS=
# [10000] how long a join waits for the host to answer.
UNCIV_RELAY_HOST_TIMEOUT_MILLIS=
# [5000] time allowed for the first message of a connection.
UNCIV_RELAY_PREAMBLE_TIMEOUT_MILLIS=
# [10] time allowed before the first byte arrives.
UNCIV_RELAY_FIRST_BYTES_SECONDS=
# [0 = off] cap on total egress in megabits per second. Set it if the server's bandwidth is limited.
UNCIV_RELAY_MAX_MBPS=
# [0 = off] cap on total traffic per 30 days in GiB. Set it if the server's traffic is metered.
UNCIV_RELAY_MAX_GIB_PER_MONTH=
