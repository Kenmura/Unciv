; Engine configuration file. Real Unciv Godot client skeleton (C001); the C000 harness project is Unciv.Godot.Harness.
config_version=5

[application]

config/name="Unciv"
run/main_scene="res://App.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4

[dotnet]

project/assembly_name="Unciv.Godot"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
